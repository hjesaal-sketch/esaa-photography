{
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "legado/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "mi-trabajo/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "contacto/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.ico",
      "use": "@vercel/static"
    },
    {
      "src": "favicon-16x16.png",
      "use": "@vercel/static"
    },
    {
      "src": "favicon-32x32.png",
      "use": "@vercel/static"
    },
    {
      "src": "apple-touch-icon.png",
      "use": "@vercel/static"
    },
    {
      "src": "android-chrome-192x192.png",
      "use": "@vercel/static"
    },
    {
      "src": "android-chrome-512x512.png",
      "use": "@vercel/static"
    },
    {
      "src": "site.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "logo.png",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/legado",
      "destination": "/legado/index.html"
    },
    {
      "source": "/mi-trabajo",
      "destination": "/mi-trabajo/index.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto/index.html"
    }
  ]
}